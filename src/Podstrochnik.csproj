<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Podstrochnik</AssemblyName>
    <RootNamespace>Podstrochnik</RootNamespace>
    <ApplicationIcon>icon_idle.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>Подстрочник</AssemblyTitle>
    <Product>Подстрочник</Product>
    <Company>REN3D</Company>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- ключ OpenRouter: если рядом лежит сгенерированный EmbeddedKey.g.cs — используем его -->
  <ItemGroup>
    <Compile Remove="EmbeddedKey.cs" Condition="Exists('EmbeddedKey.g.cs')" />
  </ItemGroup>

  <!-- папка комплекта не должна попадать в компиляцию (иначе исходники дублируются) -->
  <ItemGroup>
    <Compile Remove="dist/**" />
    <None Remove="dist/**" />
    <EmbeddedResource Remove="dist/**" />
  </ItemGroup>

  <!-- Интерфейс вшит в exe: распаковывается в %APPDATA%\Podstrochnik\ui при запуске -->
  <ItemGroup>
    <EmbeddedResource Include="app\index.html" LogicalName="ui/index.html" />
    <EmbeddedResource Include="app\style.css"  LogicalName="ui/style.css" />
    <EmbeddedResource Include="app\fonts.css"  LogicalName="ui/fonts.css" />
    <EmbeddedResource Include="app\app.js"     LogicalName="ui/app.js" />
    <EmbeddedResource Include="app\fonts\*.woff2" LogicalName="ui/fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="icon_idle.ico"  LogicalName="app/icon_idle.ico" />
    <EmbeddedResource Include="icon_busy.ico"  LogicalName="app/icon_busy.ico" />
    <EmbeddedResource Include="icon_error.ico" LogicalName="app/icon_error.ico" />
  </ItemGroup>

</Project>
